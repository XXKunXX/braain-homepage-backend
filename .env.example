# Postgres-Verbindung (z. B. von Neon, Vercel Postgres oder Railway)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# 32-Byte-Schlüssel (64 Hex-Zeichen), mit dem die PROVISIONING_SECRET-Werte
# der Instanzen in der Datenbank verschlüsselt werden. Einmal erzeugen mit:
#   openssl rand -hex 32
# und NIE ändern, sonst sind bereits gespeicherte Secrets nicht mehr lesbar.
SECRET_ENCRYPTION_KEY=

# Token, mit dem sich Braain-Instanzen selbst am Pool-Register anmelden
# (POST /api/pool/instances, Header "Authorization: Bearer <token>").
# Selbst erzeugen (z. B. `openssl rand -hex 32`) und EINMALIG, nicht per
# Chat/Mail im Klartext, an Thomas/Braain weitergeben.
POOL_REGISTRY_TOKEN=

# Basis-URL dieser Homepage/dieses Backends (ohne abschließenden Slash),
# z. B. https://braain.io oder https://konto.braain.io
HOMEPAGE_BASE_URL=https://braain.io

# Upgrade-Seite, die Free-Kunden als portalUrl an die Instanz gemeldet wird
UPGRADE_PAGE_URL=https://braain.io/upgrade
